# All variables are optional in 001-foundation. Remove placeholder values before adding real ones.

# Sentry crash reporting DSN. Unset = crash reporting disabled (inert, no network calls).
SENTRY_DSN=

# Base URL for the SmartDataPulse API (exposed to renderer via Vite import.meta.env).
VITE_API_BASE_URL=https://api.smartdatapulse.tech

# Electron auto-updater feed URL. Signing and update distribution are deferred to a later feature.
ELECTRON_UPDATE_FEED_URL=
