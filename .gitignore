# Reference / vendored material — read-only, never source of truth
_reference/

# Node / Vite
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite + TypeScript build output
dist/
dist-electron/
out/
build/
*.tsbuildinfo

# Electron-builder packaged artifacts (signed installers, unpacked dirs)
release/

# Env / secrets
.env
.env.*
!.env.example
*.local
# Block any literal secrets dir at the repo root, but NOT the SecretStore
# source directory at src/main/secrets/.
/secrets/

# Tooling caches
.vite/
.cache/
coverage/
.nyc_output/
.eslintcache

# Vitest reporter scratch — flat-file output from `npm test > <name>.txt` runs.
# `coverage/` covers the V8 reporter directory; these patterns catch the
# stdout-redirected text files (cov-final.txt, coverage-rerun.txt, etc.)
# that local dev sessions sometimes leave behind.
cov-*.txt
coverage-*.txt

# Manual editor / agent backups of root config files. Real source of truth
# is the committed file; backups are scratch.
CLAUDE.md.backup-*
*.backup-*

# Spec Kit local tooling state — written on `specify init` per-machine.
# The templates/ subdirectory is project content and stays tracked.
.specify/init-options.json
.specify/integration.json
.specify/integrations/
.specify/scripts/

# Local SQLite POS data — never commit live transaction data
*.sqlite
*.sqlite3
*.db
*.db-journal
data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Transient scratch / crash artifacts (bench smokes, MSYS stack dumps).
# Never project source.
.tmp/
*.stackdump

# Sentry
.sentryclirc

# Claude Code — personal, per-user local state (permissions, settings).
# Never commit; not project configuration.
# Exception: project-local skills tracked as project tooling.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/impeccable/
!.claude/skills/impeccable/**
